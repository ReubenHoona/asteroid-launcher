// Test stub of mlite's MDConfItem: an in-memory dconf.
#ifndef STUB_MDCONFITEM
#define STUB_MDCONFITEM

#include <QHash>
#include <QObject>
#include <QString>
#include <QVariant>

class MDConfItem : public QObject
{
public:
    explicit MDConfItem(const QString &key, QObject *parent = nullptr) : QObject(parent), m_key(key) {}

    QString key() const { return m_key; }
    QVariant value() const { return store().value(m_key); }
    QVariant value(const QVariant &def) const { return store().value(m_key, def); }
    void set(const QVariant &value) { store().insert(m_key, value); }
    void unset() { store().remove(m_key); }

    static QHash<QString, QVariant> &store()
    {
        static QHash<QString, QVariant> values;
        return values;
    }

private:
    QString m_key;
};

#endif
